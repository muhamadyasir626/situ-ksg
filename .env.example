# APP_ENV: local (dev mesin developer) | staging | production. Lihat docs/operations/deployment.md.
APP_NAME=SITU-KSG
APP_ENV=local
APP_KEY=
# APP_DEBUG harus false di staging & production — jangan pernah true di luar local (§11).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL 8, bukan PostgreSQL/SQLite (keputusan arsitektur §9).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=situksg
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Berkas bukti dukung disimpan di disk lokal privat (storage/app/private), bukan S3/MinIO (§9).
FILESYSTEM_DISK=local
# Queue driver database — tanpa Redis/Horizon (§9). Jalankan worker: php artisan queue:work.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
